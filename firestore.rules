rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permet un accès en lecture et écriture à tous les documents pour tout utilisateur authentifié.
    // Cette règle est conçue pour le développement et devra être restreinte pour la production.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
