rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Les stations sont publiques en lecture, mais seuls les admins peuvent écrire.
    match /stations/{stationId} {
      allow read: if true;
      allow write: if get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['manager', 'superadmin'];
    }

    match /clients/{clientId} {
      // Un nouvel utilisateur peut créer son propre profil.
      allow create: if request.auth.uid == clientId;
      
      // Un utilisateur peut lire son propre profil. Les admins peuvent tout lire.
      allow read: if request.auth.uid == clientId || get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['manager', 'superadmin'];

      // Seuls les admins peuvent mettre à jour, supprimer ou lister tous les clients.
      allow list, update, delete: if get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['manager', 'superadmin'];

      // Un client peut gérer ses propres réservations
      match /reservations/{reservationId} {
        allow read, list, create: if request.auth.uid == clientId;
        // Seuls les admins peuvent supprimer
        allow delete: if get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['manager', 'superadmin'];
      }
      
      // Un client peut lire/lister son propre historique
      match /history/{historyId} {
        allow read, list: if request.auth.uid == clientId;
        allow write: if get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['manager', 'superadmin'];
      }
    }
    
    // Les admins peuvent gérer les jeux
    match /games/{gameId} {
        allow read: if true;
        allow write: if get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['manager', 'superadmin'];
    }

    // Les admins peuvent gérer tous les journaux d'utilisation.
    match /usageLogs/{logId} {
       allow read, list, write: if get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['manager', 'superadmin'];
    }
    
    // Les admins ont un accès en lecture/écriture
    match /admins/{adminId} {
      allow read, write: if get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['manager', 'superadmin'];
    }
  }
}
