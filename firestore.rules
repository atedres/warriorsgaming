rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read for stations, but only authenticated write
    match /stations/{stationId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Require authentication for all other document operations
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}