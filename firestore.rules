rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Autorise l'accès en lecture/écriture à tous les documents pour tout utilisateur authentifié.
    // Cette règle est destinée au développement et doit être sécurisée pour la production.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
