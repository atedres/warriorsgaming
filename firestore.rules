/**
 * Core Philosophy: This ruleset enforces a lenient security model for development.
 * All read and write operations are permitted for any authenticated user.
 * This is NOT suitable for production but is useful for unblocking development.
 *
 * For production, you should re-introduce role-based access control,
 * for example, by checking for an admin custom claim on the user's token.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is authenticated.
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Manages all collections ('clients', 'stations', 'reservations', 'usageLogs').
     *              For development purposes, any authenticated user can read and write to any document.
     * @path /{collection}/{docId}
     * @allow (read, write) Any signed-in user can read or write any document.
     * @principle Prioritizes rapid development by removing security constraints temporarily.
     */
    match /{collection}/{docId} {
      allow read, write: if isSignedIn();
    }
  }
}
