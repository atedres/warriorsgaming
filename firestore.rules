/**
 * Core Philosophy: This ruleset enforces a lenient security model for development.
 * All read and write operations are permitted for any authenticated user.
 * This is NOT suitable for production but is useful for unblocking development.
 *
 * For production, you should re-introduce role-based access control,
 * for example, by checking for an admin custom claim on the user's token.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows collection group queries on the 'history' collection.
     *              This is necessary for the global history page to fetch all client activities.
     * @path /clients/{clientId}/history/{historyId}
     * @allow (read) Authenticated users can list and get history documents across all clients.
     */
    match /clients/{clientId}/history/{historyId} {
       allow read, write: if true;
    }

    /**
     * @description Manages all top-level collections.
     *              For development, any user can read/write to any document.
     * @path /{collection}/{docId}
     * @allow (read, write) Anyone can read or write any document.
     */
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
