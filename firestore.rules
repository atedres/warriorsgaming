rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Les stations sont publiques en lecture, mais seuls les utilisateurs authentifiés peuvent écrire.
    match /stations/{stationId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Un utilisateur ne peut lire que son propre profil client. Les admins peuvent tout lire.
    match /clients/{clientId} {
      allow read: if request.auth.uid == clientId || get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['manager', 'superadmin'];
      allow list: if get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['manager', 'superadmin'];
      allow write: if get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['manager', 'superadmin'];
    }

    // Un utilisateur ne peut lire que ses propres réservations. Les admins peuvent tout lire.
    match /reservations/{reservationId} {
      allow read, create: if request.auth != null && (request.resource.data.clientId == request.auth.uid || get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['manager', 'superadmin']));
      allow list: if get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['manager', 'superadmin'];
      allow update, delete: if get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['manager', 'superadmin'];
    }

    // Les admins peuvent gérer tous les journaux d'utilisation.
    match /usageLogs/{logId} {
       allow read, list, write: if get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['manager', 'superadmin'];
    }

    // Par défaut, refuser toutes les autres opérations, sauf si l'utilisateur est authentifié.
    // Des règles plus spécifiques ci-dessus ont la priorité.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
