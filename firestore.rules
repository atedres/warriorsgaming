rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Les stations sont publiques en lecture, mais seuls les admins peuvent écrire.
    match /stations/{stationId} {
      allow read: if true;
      allow write: if get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['manager', 'superadmin'];
    }

    match /clients/{clientId} {
      // Un nouvel utilisateur peut créer son propre profil.
      allow create: if request.auth.uid == clientId;
      
      // Un utilisateur peut lire son propre profil. Les admins peuvent tout lire.
      allow read, update: if request.auth.uid == clientId || get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['manager', 'superadmin'];

      // Seuls les admins peuvent mettre à jour, supprimer ou lister tous les clients.
      allow list, delete: if get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['manager', 'superadmin'];

      // Gestion des sous-collections
      match /reservations/{reservationId} {
        // Un client peut créer, lire et supprimer ses propres réservations
        allow create, read, list, delete: if request.auth.uid == clientId;
        // Les admins peuvent lire, mettre à jour (confirmer) et supprimer n'importe quelle réservation.
        allow update, delete: if get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['manager', 'superadmin'];
      }
      
      // Un client peut lire son historique, les admins peuvent aussi le lire et y écrire.
      match /history/{historyId} {
        allow read, list: if request.auth.uid == clientId || get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['manager', 'superadmin'];
        allow write: if get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['manager', 'superadmin'];
      }
    }
    
    // Les admins peuvent gérer les jeux
    match /games/{gameId} {
        allow read: if true;
        allow write: if get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['manager', 'superadmin'];
    }

    // Les admins peuvent gérer les promotions
    match /promotions/{promoId} {
        allow read: if true;
        allow write: if get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['manager', 'superadmin'];
    }

    // Les admins peuvent gérer les cartes d'abonnement
    match /subscriptionCards/{cardId} {
      allow read, write: if get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['manager', 'superadmin'];
    }

    // Les admins peuvent gérer tous les journaux d'utilisation.
    match /usageLogs/{logId} {
       allow read, list, write: if get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['manager', 'superadmin'];
    }
    
    // Les admins ont un accès en lecture/écriture à leurs propres documents admin
    match /admins/{adminId} {
      allow read, write: if request.auth.uid == adminId || get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superadmin';
    }
    
    // Les admins peuvent lire/écrire les paramètres du site
    match /site_settings/{settingId} {
      allow read: if true; // Publicly readable
      allow write: if get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['manager', 'superadmin'];
    }

    // Règle pour la collection de groupe 'reservations' (permet aux admins de lister toutes les réservations)
    match /{path=**}/reservations/{reservationId} {
      allow read, list: if get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['manager', 'superadmin'];
    }
  }
}
